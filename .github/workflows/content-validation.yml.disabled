name: Content Validation

on:
  push:
    branches: [ main, develop ]
    paths:
      - 'src/**/*.md'
      - 'assets/**'
      - 'scripts/**'
      - 'package*.json'
  pull_request:
    branches: [ main ]
    paths:
      - 'src/**/*.md'
      - 'assets/**'
      - 'scripts/**'
      - 'package*.json'

jobs:
  validate:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '20'
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Run Markdown linting
      run: npm run lint
      
    - name: Run spell checking
      run: npm run spell
      
    - name: Run link checking
      run: npm run link-check
      continue-on-error: true # Allow link checks to fail for external links
      
    - name: Run content validation
      run: npm run validate
      
    - name: Generate validation report
      run: npm run test:report
      
    - name: Upload validation report
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: validation-report
        path: validation-reports/
        retention-days: 30
        
    - name: Comment PR with validation results
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          const path = './validation-reports/validation-report.json';
          
          if (fs.existsSync(path)) {
            const report = JSON.parse(fs.readFileSync(path, 'utf8'));
            
            const comment = `
          ## 📋 コンテンツ検証レポート
          
          **検証統計:**
          - ✅ 検証ファイル数: ${report.stats.filesChecked}
          - 🔗 チェックしたリンク数: ${report.stats.linksChecked}  
          - 🖼️ チェックした画像数: ${report.stats.imagesChecked}
          - ❌ エラー: ${report.summary.errors}
          - ⚠️ 警告: ${report.summary.warnings}
          
          ${report.summary.errors > 0 ? '**エラーがあります。修正が必要です。**' : ''}
          ${report.summary.warnings > 0 ? '**警告があります。確認をお願いします。**' : ''}
          ${report.summary.errors === 0 && report.summary.warnings === 0 ? '**✅ すべての検証項目をパスしました！**' : ''}
          
          詳細なレポートは Artifacts からダウンロードできます。
          `;
          
          github.rest.issues.createComment({
            issue_number: context.issue.number,
            owner: context.repo.owner,
            repo: context.repo.repo,
            body: comment
          });
          }
          
  # Run textlint separately as it might be more strict
  textlint:
    runs-on: ubuntu-latest
    continue-on-error: true
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '20'
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Run textlint
      run: npm run textlint
